  {
    "id": "4a107bbd",
    "type": "function",
    "z": "4a100000",
    "name": "解析 CH1/CH2/CH3 与状态（实际时间）",
    "func": "const body = msg.payload;\nif (msg.statusCode !== 200 || !body || body.code !== 0 || !Array.isArray(body.data)) {\n  const detail = body && (body.msg || body.message) ? (body.msg || body.message) : \"HTTP \" + (msg.statusCode || \"错误\");\n  node.status({fill:\"red\",shape:\"ring\",text:detail});\n  return [null,null,null,null,null];\n}\nconst p = Object.fromEntries(body.data.map(item => [item.identifier,item]));\nconst num = value => { const n=Number(value); return Number.isFinite(n) ? n : null; };\nconst bool = value => value === true || value === \"true\" || value === 1 || value === \"1\";\nconst aliases = {\n  CH1:[\"CH1\",\"ch1\",\"CH_1\",\"Voltage_CH1\",\"Voltage1\",\"voltage1\"],\n  CH2:[\"CH2\",\"ch2\",\"CH_2\",\"Voltage_CH2\",\"Voltage2\",\"voltage2\"],\n  CH3:[\"CH3\",\"ch3\",\"CH_3\",\"Voltage_CH3\",\"Voltage3\",\"voltage3\"]\n};\nconst readChannel = names => {\n  for (const name of names) {\n    const item = p[name];\n    const value = num(item && item.value);\n    if (value !== null) return {value,time:num(item.time)};\n  }\n  return {value:null,time:null};\n};\nconst channels = {CH1:readChannel(aliases.CH1),CH2:readChannel(aliases.CH2),CH3:readChannel(aliases.CH3)};\nif (channels.CH1.value === null && p.Voltage) channels.CH1 = {value:num(p.Voltage.value),time:num(p.Voltage.time)};\nconst validValues = Object.values(channels).filter(item => item.value !== null);\nif (!validValues.length) {\n  node.status({fill:\"yellow\",shape:\"ring\",text:\"暂无 CH1/CH2/CH3\"});\n  return [null,null,null,null,null];\n}\nconst sampleTime = Math.max(...validValues.map(item => item.time || 0)) || Date.now();\nconst relayOn = bool(p.ralay_status && p.ralay_status.value);\nconst statusText = relayOn ? \"放电（继电器1～3全部吸合）\" : \"充电（继电器1～3全部断开）\";\nconst cycleValue = num(p.cycle_count && p.cycle_count.value) ?? \"--\";\nconst common = {channels:Object.fromEntries(Object.entries(channels).map(([key,item]) => [key,item.value])),timestamp:sampleTime,statusText,cycleValue};\nnode.status({fill:\"green\",shape:\"dot\",text:validValues.length+\" 路电压已更新\"});\nconst output = name => channels[name].value === null ? null : {payload:channels[name].value,topic:name,...common};\nreturn [output(\"CH1\"),output(\"CH2\"),output(\"CH3\"),{payload:statusText},{payload:cycleValue}];",
