采样时间</span>{{formatFullTime(hoverPoint.x)}}</div><div v-for=\"item in series\" :key=\"item.key\"><span>{{item.name}}</span>{{formatValue(hoverPoint.values[item.key])}}</div></div>\n    <div v-if=\"!points.length\" class=\"rs485-empty\">等待第一条真实采样数据...</div>\n  </div>\n</div>\n</template>\n<script>\nexport default {\n  data(){return {points:[],viewStart:0,viewEnd:0,zoomed:false,hoverPoint:null,tooltipX:0,tooltipY:0}},\n  watch:{msg:{deep:true,immediate:true,handler(value){if(!value||!Array.isArray(value.payload))return;this.points=value.payload.map(point=>({x:Number(point.x),values:{CH1:Number(point.values&&point.values.CH1),CH2:Number(point.values&&point.values.CH2),CH3:Number(point.values&&point.values.CH3)}})).filter(point=>Number.isFinite(point.x)&&Object.values(point.values).some(Number.isFinite)).sort((a,b)=>a.x-b.x);if(!this.zoomed||!this.viewStart||!this.viewEnd)this.resetZoom()}}},\n  computed:{\n    dataStart(){return this.points.length?this.points[0].x:Date.now()-30000},dataEnd(){return this.points.length?this.points[this.points.length-1].x:Date.now()},\n    visible(){const result=this.points.filter(point=>point.x>=this.viewStart&&point.x<=this.viewEnd);return result.length?result:this.points.slice(-1)},\n    series(){return [{key:'CH1',name:'CH1',color:'#29b6f6'},{key:'CH2',name:'CH2',color:'#42d392'},{key:'CH3',name:'CH3',color:'#ffa726'}].map(item=>({...item,points:this.visible.filter(point=>Number.isFinite(point.values[item.key])).map(point=>({x:point.x,value:point.values[item.key]}))}))},\n    plottedPoints(){return this.series.flatMap(item=>item.points.map(point=>({...point,values:this.points.find(sample=>sample.x===point.x)?.values||{},color:item.color,key:item.key+'-'+point.x})))},\n    yRange(){const values=this.series.flatMap(item=>item.points.map(point=>point.value));if(!values.length)return {min:0,max:17};const min=Math.min(...values),max=Math.max(...values),pad=Math.max((max-min)*.18,.05);return {min:min-pad,max:max+pad}},\n    yTicks(){return Array.from({length:6},(_,i)=>{const value=this.yRange.max-(this.yRange.max-this.yRange.min)*i/5;return {value,y:18+342*i/5}})},\n    xTicks(){const start=this.viewStart||this.dataStart,end=this.viewEnd||this.dataEnd;return Array.from({length:6},(_,i)=>({value:start+(end-start)*i/5,x:68+912*i/5}))}\n  },\n  methods:{\n    resetZoom(){this.viewStart=this.dataStart;this.viewEnd=Math.max(this.dataEnd,this.dataStart+30000);this.zoomed=false;this.hoverPoint=null},\n    line(points){return points.map(point=>this.scaleX(point.x)+','+this.scaleY(point.value)).join(' ')},\n    scaleX(value){return 68+(value-this.viewStart)/Math.max(this.viewEnd-this.viewStart,1)*912},scaleY(value){return 18+(this.yRange.max-value)/Math.max(this.yRange.max-this.yRange.min,.001)*342},\n    formatTime(value){return new Date(value).toLocaleTimeString('zh-CN',{hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'Asia/Shanghai'})},formatFullTime(value){return new Date(value).toLocaleString('zh-CN',{hour12:false,timeZone:'Asia/Shanghai'})},formatValue(value){return Number.isFinite(value)?value.toFixed(4)+' V':'--'},\n    showTooltip(event,point){const rect=this.$refs.plot.getBoundingClientRect();this.hoverPoint=point;this.tooltipX=Math.max(8,Math.min(rect.width-235,event.clientX-rect.left+14));this.tooltipY=Math.max(8,Math.min(rect.height-110,event.clientY-rect.top-90))},\n    onWheel(event){if(this.points.length<2)return;const span=Math.max(this.viewEnd-this.viewStart,30000),full=Math.max(this.dataEnd-this.dataStart,30000),factor=event.deltaY<0?.75:1.333333,newSpan=Math.max(30000,Math.min(full,span*factor)),ratio=Math.max(0,Math.min(1,(event.offsetX/this.$refs.plot.clientWidth))),anchor=this.viewStart+span*ratio;this.viewStart=Math.max(this.dataStart,anchor-newSpan*ratio);this.viewEnd=Math.min(this.dataEnd,anchor+newSpan*(1-ratio));if(this.viewEnd-this.viewStart<newSpan)this.viewStart=Math.max(this.dataStart,this.viewEnd-newSpan);this.zoomed=true}\n  }\n}\n</script>\n<style>\n.rs485-zoom-chart{height:100%;display:flex;flex-direction:column;padding:4px 8px 8px;color:#dceeff}.rs485-chart-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:2px 4px 4px}.rs485-chart-title{font-size:18px;font-weight:600}.rs485-chart-hint{margin-top:2px;font-size:12px;color:#8fa9bd}.rs485-legend{display:flex;gap:18px;padding:0 4px 6px;font-size:12px;color:#afc6d7}.rs485-legend i{display:inline-block;width:10px;height:10px;margin-right:5px;border-radius:50%}.rs485-plot{position:relative;flex:1;min-height:310px;overflow:hidden;touch-action:none;cursor:crosshair;user-select:none}.rs485-plot svg{display:block;width:100%;height:100%}.rs485-grid{stroke:#294158;stroke-width:1;vector-effect:non-scaling-stroke}.rs485-grid-x{stroke-dasharray:4 5;opacity:.65}.rs485-axis{stroke:#6f8da3;stroke-width:1.2;vector-effect:non-scaling-stroke}.rs485-axis-text{fill:#9fb5c6;font-size:13px;font-family:'Microsoft YaHei',sans-serif}.rs485-axis-title{fill:#cfe2ef;font-size:14px;font-family:'Microsoft YaHei',sans-serif}.rs485-line{fill:none;stroke-width:3;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke}.rs485-point{stroke:#07131f;stroke-width:2;vector-effect:non-scaling-stroke;cursor:crosshair}.rs485-point:hover{stroke:#fff;stroke-width:3}.rs485-tooltip{position:absolute;z-index:5;min-width:220px;padding:9px 12px;border:1px solid #3f7898;border-radius:8px;background:rgba(7,19,31,.94);color:#f2f8fc;font-size:14px;line-height:1.8;box-shadow:0 8px 24px rgba(0,0,0,.35);pointer-events:none}.rs485-tooltip span{display:inline-block;width:64px;color:#8fdcff;font-weight:600}.rs485-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#8fa9bd}\n</style>",
