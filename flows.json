    "type": "function",
    "z": "4a100000",
    "name": "保存 CH1 CH2 CH3 曲线与表格记录",
    "func": "const timestamp = Number(msg.timestamp) || Date.now();\nconst toNumber = value => {\n  if (value === null || value === undefined || value === \"\") return null;\n  const n = Number(value);\n  return Number.isFinite(n) ? n : null;\n};\nconst source = msg.channels || {};\nconst values = {\n  CH1: toNumber(source.CH1),\n  CH2: toNumber(source.CH2),\n  CH3: toNumber(source.CH3)\n};\nif (values[msg.topic] === null) values[msg.topic] = toNumber(msg.payload);\nif (!Object.values(values).some(value => value !== null)) return [null,null];\n\nlet points = context.get(\"points\") || [];\nconst duplicate = points.length && points[points.length - 1].x === timestamp;\nconst point = {x:timestamp, values};\nif (duplicate) points[points.length - 1] = point;\nelse points.push(point);\nif (points.length > 120) points = points.slice(-120);\ncontext.set(\"points\", points);\n\nlet records = context.get(\"records\") || [];\nconst display = value => value === null ? \"--\" : value.toFixed(4);\nconst record = {\n  \"采样时间\": new Date(timestamp).toLocaleString(\"zh-CN\", {hour12:false,timeZone:\"Asia/Shanghai\"}),\n  \"CH1(V)\": display(values.CH1),\n  \"CH2(V)\": display(values.CH2),\n  \"CH3(V)\": display(values.CH3),\n  \"当前状态\": msg.statusText || \"--\",\n  \"循环次数\": msg.cycleValue ?? \"--\"\n};\nif (duplicate && records.length) records[0] = record;\nelse records.unshift(record);\nif (records.length > 120) records = records.slice(0, 120);\ncontext.set(\"records\", records);\n\nreturn [\n  {payload:points},\n  {payload:records}\n];",
