  {
    "id": "4a12899b",
    "type": "function",
    "z": "4a100000",
    "name": "保存曲线与表格记录",
    "func": "const timestamp = Number(msg.timestamp) || Date.now();\nconst voltage = Number(msg.payload);\nif (!Number.isFinite(voltage)) return [null,null];\n\nlet points = context.get(\"points\") || [];\nconst duplicate = points.length && points[points.length - 1].x === timestamp;\nconst point = {x:timestamp,y:Number(voltage.toFixed(4))};\nif (duplicate) points[points.length - 1] = point;\nelse points.push(point);\nif (points.length > 120) points = points.slice(-120);\ncontext.set(\"points\", points);\n\nlet records = context.get(\"records\") || [];\nconst record = {\n  \"采样时间\": new Date(timestamp).toLocaleString(\"zh-CN\", {hour12:false,timeZone:\"Asia/Shanghai\"}),\n  \"总电压(V)\": voltage.toFixed(4),\n  \"当前状态\": msg.statusText || \"--\",\n  \"循环次数\": msg.cycleValue ?? \"--\"\n};\nif (duplicate && records.length) records[0] = record;\nelse records.unshift(record);\nif (records.length > 120) records = records.slice(0, 120);\ncontext.set(\"records\", records);\n\nreturn [\n  {payload:points},\n  {payload:records}\n];",
    "outputs": 2,
