  {
    "id": "4a10d889",
    "type": "ui-template",
    "z": "4a100000",
    "group": "4a124bbd",
    "page": "",
    "ui": "",
    "name": "可缩放电压曲线",
    "order": 1,
    "width": 12,
    "height": 7,
    "head": "",
    "format": "<template>\n  <div class=\"rs485-zoom-chart\">\n    <div class=\"rs485-chart-head\">\n      <div>\n        <div class=\"rs485-chart-title\">电压记录（每30秒）</div>\n        <div class=\"rs485-chart-hint\">曲线区域内滚轮缩放 · 按住鼠标拖动 · 双击复位</div>\n      </div>\n      <v-btn size=\"small\" variant=\"tonal\" color=\"primary\" @click=\"resetZoom\">复位</v-btn>\n    </div>\n    <div ref=\"plot\" class=\"rs485-plot\"\n         @wheel.prevent.stop=\"onWheel\"\n         @pointerdown=\"onPointerDown\"\n         @pointermove=\"onPointerMove\"\n         @pointerup=\"onPointerUp\"\n         @pointercancel=\"onPointerUp\"\n         @dblclick=\"resetZoom\">\n      <svg viewBox=\"0 0 1000 410\" preserveAspectRatio=\"none\" aria-label=\"可缩放电压曲线\">\n        <g v-for=\"tick in yTicks\" :key=\"'y'+tick.value\">\n          <line x1=\"68\" x2=\"980\" :y1=\"tick.y\" :y2=\"tick.y\" class=\"rs485-grid\"/>\n          <text x=\"58\" :y=\"tick.y + 5\" text-anchor=\"end\" class=\"rs485-axis-text\">{{ tick.value.toFixed(2) }}</text>\n        </g>\n        <g v-for=\"tick in xTicks\" :key=\"'x'+tick.value\">\n          <line :x1=\"tick.x\" :x2=\"tick.x\" y1=\"18\" y2=\"360\" class=\"rs485-grid rs485-grid-x\"/>\n          <text :x=\"tick.x\" y=\"390\" text-anchor=\"middle\" class=\"rs485-axis-text\">{{ formatTime(tick.value) }}</text>\n        </g>\n        <line x1=\"68\" x2=\"980\" y1=\"360\" y2=\"360\" class=\"rs485-axis\"/>\n        <line x1=\"68\" x2=\"68\" y1=\"18\" y2=\"360\" class=\"rs485-axis\"/>\n        <text x=\"18\" y=\"190\" text-anchor=\"middle\" class=\"rs485-axis-title\" transform=\"rotate(-90 18 190)\">电压 (V)</text>\n        <polyline v-if=\"visiblePoints.length\" :points=\"polyline\" class=\"rs485-line\"/>\n        <g v-if=\"hoverPoint\" class=\"rs485-crosshair\">\n          <line :x1=\"scaleX(hoverPoint.x)\" :x2=\"scaleX(hoverPoint.x)\" y1=\"18\" y2=\"360\"/>\n          <line x1=\"68\" x2=\"980\" :y1=\"scaleY(hoverPoint.y)\" :y2=\"scaleY(hoverPoint.y)\"/>\n        </g>\n        <circle v-for=\"p in visiblePoints\" :key=\"p.x\" :cx=\"scaleX(p.x)\" :cy=\"scaleY(p.y)\" r=\"6\" class=\"rs485-point\"\n                @mouseenter=\"showTooltip($event, p)\"\n                @mousemove=\"showTooltip($event, p)\"\n                @mouseleave=\"hideTooltip\"/>\n      </svg>\n      <div v-if=\"hoverPoint\" class=\"rs485-tooltip\" :style=\"{left:tooltipX+'px',top:tooltipY+'px'}\">\n        <div><span>横坐标</span>{{ formatFullTime(hoverPoint.x) }}</div>\n        <div><span>纵坐标</span>{{ hoverPoint.y.toFixed(4) }} V</div>\n      </div>\n      <div v-if=\"!points.length\" class=\"rs485-empty\">等待第一条采样数据...</div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      points: [],\n      viewStart: 0,\n      viewEnd: 0,\n      zoomed: false,\n      dragging: false,\n      dragClientX: 0,\n      dragViewStart: 0,\n      dragViewEnd: 0,\n      hoverPoint: null,\n      tooltipX: 0,\n      tooltipY: 0\n    }\n  },\n  watch: {\n    msg: {\n      deep: true,\n      immediate: true,\n      handler(value) {\n        if (!value || !Array.isArray(value.payload)) return\n        this.points = value.payload\n          .map(p => ({x:Number(p.x), y:Number(p.y)}))\n          .filter(p => Number.isFinite(p.x) && Number.isFinite(p.y))\n          .sort((a,b) => a.x - b.x)\n        if (!this.zoomed || !this.viewStart || !this.viewEnd) this.resetZoom()\n      }\n    }\n  },\n  computed: {\n    dataStart() { return this.points.length ? this.points[0].x : Date.now() - 30000 },\n    dataEnd() { return this.points.length ? this.points[this.points.length - 1].x : Date.now() },\n    visiblePoints() {\n      if (!this.points.length) return []\n      const visible = this.points.filter(p => p.x >= this.viewStart && p.x <= this.viewEnd)\n      return visible.length ? visible : this.points.slice(-1)\n    },\n    yRange() {\n      const source = this.visiblePoints.length ? this.visiblePoints : this.points\n      if (!source.length) return {min:12, max:17}\n      let min = Math.min(...source.map(p => p.y))\n      let max = Math.max(...source.map(p => p.y))\n      const pad = Math.max((max - min) * 0.18, 0.05)\n      min -= pad\n      max += pad\n      return {min, max}\n    },\n    polyline() {\n      return this.visiblePoints.map(p => `${this.scaleX(p.x)},${this.scaleY(p.y)}`).join(' ')\n    },\n    yTicks() {\n      const ticks = []\n      for (let i=0; i<6; i++) {\n        const value = this.yRange.max - (this.yRange.max-this.yRange.min) * i / 5\n        ticks.push({value, y:18 + 342*i/5})\n      }\n      return ticks\n    },\n    xTicks() {\n      const ticks = []\n      const start = this.viewStart || this.dataStart\n      const end = this.viewEnd || this.dataEnd\n      for (let i=0; i<6; i++) {\n        const value = start + (end-start)*i/5\n        ticks.push({value, x:68 + 912*i/5})\n      }\n      return ticks\n    }\n  },\n  methods: {\n    resetZoom() {\n      let start = this.dataStart\n      let end = this.dataEnd\n      if (end - start < 30000) {\n        const middle = (start + end) / 2\n        start = middle - 15000\n        end = middle + 15000\n      }\n      this.viewStart = start\n      this.viewEnd = end\n      this.zoomed = false\n    },\n    scaleX(value) {\n      const span = Math.max(this.viewEnd - this.viewStart, 1)\n      return 68 + (value - this.viewStart) / span * 912\n    },\n    scaleY(value) {\n      const span = Math.max(this.yRange.max - this.yRange.min, 0.001)\n      return 18 + (this.yRange.max - value) / span * 342\n    },\n    formatTime(value) {\n      return new Date(value).toLocaleTimeString('zh-CN', {hour12:false,hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'Asia/Shanghai'})\n    },\n    formatFullTime(value) {\n      return new Date(value).toLocaleString('zh-CN', {hour12:false,timeZone:'Asia/Shanghai'})\n    },\n    showTooltip(event, point) {\n      const rect = this.$refs.plot.getBoundingClientRect()\n      this.hoverPoint = point\n      this.tooltipX = Math.max(8, Math.min(rect.width - 235, event.clientX - rect.left + 14))\n      this.tooltipY = Math.max(8, Math.min(rect.height - 78, event.clientY - rect.top - 70))\n    },\n    hideTooltip() {\n      this.hoverPoint = null\n    },\n    clampWindow(start, end) {\n      const fullStart = this.dataStart\n      const fullEnd = this.dataEnd\n      const fullSpan = Math.max(fullEnd-fullStart, 30000)\n      const span = end-start\n      if (span >= fullSpan) return {start:fullStart, end:fullEnd}\n      if (start < fullStart) { end += fullStart-start; start=fullStart }\n      if (end > fullEnd) { start -= end-fullEnd; end=fullEnd }\n      return {start,end}\n    },\n    onWheel(event) {\n      if (this.points.length < 2) return\n      const rect = this.$refs.plot.getBoundingClientRect()\n      const ratio = Math.max(0, Math.min(1, (event.clientX-rect.left)/rect.width))\n      const oldSpan = Math.max(this.viewEnd-this.viewStart, 30000)\n      const fullSpan = Math.max(this.dataEnd-this.dataStart, 30000)\n      const factor = event.deltaY < 0 ? 0.75 : 1.333333\n      const newSpan = Math.max(30000, Math.min(fullSpan, oldSpan*factor))\n      const anchor = this.viewStart + oldSpan*ratio\n      let start = anchor-newSpan*ratio\n      let end = start+newSpan\n      const clamped = this.clampWindow(start,end)\n      this.viewStart=clamped.start\n      this.viewEnd=clamped.end\n      this.zoomed = newSpan < fullSpan-1\n    },\n    onPointerDown(event) {\n      if (this.points.length < 2) return\n      this.dragging=true\n      this.dragClientX=event.clientX\n      this.dragViewStart=this.viewStart\n      this.dragViewEnd=this.viewEnd\n      event.currentTarget.setPointerCapture(event.pointerId)\n    },\n    onPointerMove(event) {\n      if (!this.dragging) return\n      const rect=this.$refs.plot.getBoundingClientRect()\n      const span=this.dragViewEnd-this.dragViewStart\n      const shift=-(event.clientX-this.dragClientX)/rect.width*span\n      const clamped=this.clampWindow(this.dragViewStart+shift,this.dragViewEnd+shift)\n      this.viewStart=clamped.start\n      this.viewEnd=clamped.end\n    },\n    onPointerUp(event) {\n      if (!this.dragging) return\n      this.dragging=false\n      this.zoomed=true\n      if (event.currentTarget.hasPointerCapture(event.pointerId)) event.currentTarget.releasePointerCapture(event.pointerId)\n    }\n  }\n}\n</script>\n\n<style>\n.rs485-zoom-chart { height:100%; display:flex; flex-direction:column; padding:4px 8px 8px; color:#dceeff; }\n.rs485-chart-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:2px 4px 8px; }\n.rs485-chart-title { font-size:18px; font-weight:600; }\n.rs485-chart-hint { margin-top:2px; font-size:12px; color:#8fa9bd; }\n.rs485-plot { position:relative; flex:1; min-height:310px; overflow:hidden; touch-action:none; cursor:grab; user-select:none; }\n.rs485-plot:active { cursor:grabbing; }\n.rs485-plot svg { display:block; width:100%; height:100%; }\n.rs485-grid { stroke:#294158; stroke-width:1; vector-effect:non-scaling-stroke; }\n.rs485-grid-x { stroke-dasharray:4 5; opacity:.65; }\n.rs485-axis { stroke:#6f8da3; stroke-width:1.2; vector-effect:non-scaling-stroke; }\n.rs485-axis-text { fill:#9fb5c6; font-size:13px; font-family:'Microsoft YaHei',sans-serif; }\n.rs485-axis-title { fill:#cfe2ef; font-size:14px; font-family:'Microsoft YaHei',sans-serif; }\n.rs485-line { fill:none; stroke:#29b6f6; stroke-width:3; stroke-linejoin:round; stroke-linecap:round; vector-effect:non-scaling-stroke; }\n.rs485-point { fill:#07131f; stroke:#61dafb; stroke-width:2.5; vector-effect:non-scaling-stroke; cursor:crosshair; }\n.rs485-point:hover { fill:#61dafb; stroke:#ffffff; stroke-width:3; }\n.rs485-crosshair line { stroke:#8fdcff; stroke-width:1; stroke-dasharray:5 5; opacity:.7; vector-effect:non-scaling-stroke; pointer-events:none; }\n.rs485-tooltip { position:absolute; z-index:5; min-width:215px; padding:9px 12px; border:1px solid #3f7898; border-radius:8px; background:rgba(7,19,31,.94); color:#f2f8fc; font-size:14px; line-height:1.8; box-shadow:0 8px 24px rgba(0,0,0,.35); pointer-events:none; }\n.rs485-tooltip span { display:inline-block; width:58px; color:#8fdcff; font-weight:600; }\n.rs485-empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#8fa9bd; }\n</style>",
