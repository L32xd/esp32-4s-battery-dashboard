  {
    "id": "4a107bbc",
    "type": "function",
    "z": "4a100000",
    "name": "解析电压与状态",
    "func": "const body = msg.payload;\nif (msg.statusCode !== 200 || !body || body.code !== 0 || !Array.isArray(body.data)) {\n  const detail = body && (body.msg || body.message) ? (body.msg || body.message) : \"HTTP \" + (msg.statusCode || \"错误\");\n  node.status({fill:\"red\",shape:\"ring\",text:detail});\n  return [null,null,null];\n}\nconst p = Object.fromEntries(body.data.map(item => [item.identifier,item]));\nconst num = value => { const n=Number(value); return Number.isFinite(n) ? n : null; };\nconst bool = value => value === true || value === \"true\" || value === 1 || value === \"1\";\nconst voltage = num(p.Voltage && p.Voltage.value);\nif (voltage === null) {\n  node.status({fill:\"yellow\",shape:\"ring\",text:\"暂无 Voltage\"});\n  return [null,null,null];\n}\nconst sampleTime = num(p.Voltage && p.Voltage.time) || Date.now();\nconst relayOn = bool(p.ralay_status && p.ralay_status.value);\nconst statusText = relayOn ? \"放电（继电器1～3全部吸合）\" : \"充电（继电器1～3全部断开）\";\nconst cycleValue = num(p.cycle_count && p.cycle_count.value) ?? \"--\";\nnode.status({fill:\"green\",shape:\"dot\",text:voltage.toFixed(4)+\" V\"});\nreturn [\n  {payload:voltage,topic:\"组内总电压\",timestamp:sampleTime,statusText,cycleValue},\n  {payload:statusText},\n  {payload:cycleValue}\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 880,
    "y": 100,
    "wires": [
      [
        "4a10b99a",
        "4a12899b"
      ],
      [
        "4a10f778"
      ],
      [
        "4a113556"
      ]
    ]
  },
