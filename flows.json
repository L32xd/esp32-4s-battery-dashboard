  {
    "id": "4a103dde",
    "type": "function",
    "z": "4a100000",
    "name": "准备 OneNET API 请求",
    "func": "const auth = env.get(\"ONENET_AUTHORIZATION\");\nconst base = env.get(\"ONENET_API_BASE\") || \"https://iot-api.heclouds.com\";\nconst productId = env.get(\"ONENET_PRODUCT_ID\") || \"025rYnzKk0\";\nconst deviceName = env.get(\"ONENET_DEVICE_NAME\") || \"4S\";\nif (!auth) {\n  node.status({fill:\"red\",shape:\"ring\",text:\"缺少鉴权配置\"});\n  return null;\n}\nmsg.method = \"GET\";\nmsg.url = base + \"/thingmodel/query-device-property?product_id=\" + encodeURIComponent(productId) + \"&device_name=\" + encodeURIComponent(deviceName);\nmsg.headers = {Accept:\"application/json, text/plain, */*\", authorization:auth};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
